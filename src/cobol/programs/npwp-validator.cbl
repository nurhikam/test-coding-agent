*> Purpose: Validates a customer NPWP number before it reaches the tax office.

IDENTIFICATION DIVISION.
PROGRAM-ID. NPWP-VALIDATOR.

ENVIRONMENT DIVISION.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "npwp-data.cpy".

01  CHECK-DIGIT      PIC 9(2).
01  RUNNING-TOTAL    PIC 9(4).
01  IDX              PIC 9(2).
01  WEIGHTS          PIC X(16) VALUE "3579137913579137".

PROCEDURE DIVISION.
MAIN-LOGIC.
    DISPLAY "NPWP Validator: entering MAIN-LOGIC"
    PERFORM CHECK-FORMAT
    IF VALID-FLAG = 'N'
        DISPLAY "NPWP " NPWP-NUMBER " rejected: " ERROR-MESSAGE
        STOP RUN
    END-IF
    PERFORM CHECK-SUM
    STOP RUN.

CHECK-FORMAT.
    IF NPWP-NUMBER = SPACE
        MOVE 'N' TO VALID-FLAG
        MOVE "ERR-NPWP-001" TO ERROR-CODE
        MOVE "NPWP number is required" TO ERROR-MESSAGE
    END-IF.

CHECK-SUM.
    MOVE 0 TO RUNNING-TOTAL
    PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 15
        COMPUTE RUNNING-TOTAL = RUNNING-TOTAL +
            (FUNCTION NUMVAL(NPWP-NUMBER(IDX:1)) *
             FUNCTION NUMVAL(WEIGHTS(IDX:1)))
    END-PERFORM
    COMPUTE CHECK-DIGIT = FUNCTION MOD(RUNNING-TOTAL, 11)
    IF CHECK-DIGIT = 0
        MOVE 'Y' TO VALID-FLAG
    ELSE
        MOVE 'N' TO VALID-FLAG
        MOVE "ERR-NPWP-002" TO ERROR-CODE
    END-IF.
